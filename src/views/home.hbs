<div class="hero">
    <div class="container">

        <div class="left">

            <h1 class="h1">
                Xin chào, tôi là <b>Hung&nbsp;Nguyen</b>.
                <br>Lập trình viên Web
            </h1>

            <p class="h3">
                Chuyên về <abbr title="Khả năng tiếp cận">khả năng tiếp cận</abbr>
                và hiệu suất website
            </p>

            <div>
                <a href="/contact" class="btn btn-primary">
                    Liên hệ với tôi
                </a>

                <a href="/about" class="btn btn-secondary">
                    Giới thiệu
                </a>
            </div>

        </div>


        <div class="right">

            <div class="pattern-bg"></div>

            <div class="img-box">

                <img
                    src="/img/hero.png"
                    alt="Ảnh đại diện Hung Nguyen"
                    class="hero-img">

                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>

            </div>

        </div>

    </div>
</div>


<div class="main">

    <div class="container">


        <!-- =========================
             DANH SÁCH BÀI VIẾT
        ========================== -->

        <div class="blog">

            <h2 class="h2">
                Bài viết mới nhất
            </h2>


            <div class="blog-card-group">


                {{#each blogs}}


                <div class="blog-card">


                    <!-- ẢNH BÀI VIẾT -->

                    <div class="blog-card-banner">

                        <img
                            src="{{this.image}}"
                            alt="{{this.name}}"
                            width="250"
                            class="blog-banner-img">

                    </div>


                    <!-- NỘI DUNG BÀI VIẾT -->

                    <div class="blog-content-wrapper">


                        <button class="blog-topic text-tiny">
                            Bài viết
                        </button>


                        <!-- TIÊU ĐỀ -->

                        <h3>

                            <a
                                href="/blogs/{{this.slug}}"
                                class="h3">

                                {{this.name}}

                            </a>

                        </h3>


                        <!-- MÔ TẢ -->

                        <p class="blog-text">

                            {{this.description}}

                        </p>


                        <!-- THÔNG TIN BÀI VIẾT -->

                        <div class="wrapper-flex">


                            <div class="wrapper">


                                <a href="#" class="h4">
                                    Quản trị viên
                                </a>


                                <!-- NGÀY ĐĂNG -->

                                <p class="text-sm">

                                    <time>

                                        {{this.createdAtVN}}

                                    </time>

                                </p>


                            </div>


                        </div>


                        <!-- =========================
                             NÚT SỬA / XÓA
                        ========================== -->

                        <div class="blog-card-actions">


                            <!-- SỬA -->

                            <a
                                href="/blogs/{{this._id}}/edit"
                                class="blog-action-btn edit">

                                <ion-icon
                                    name="create-outline">
                                </ion-icon>

                                <span>Sửa</span>

                            </a>


                            <!-- XÓA -->

                            <form
                                method="POST"
                                action="/blogs/{{this._id}}?_method=DELETE"
                                onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">


                                <button
                                    type="submit"
                                    class="blog-action-btn delete">

                                    <ion-icon
                                        name="trash-outline">
                                    </ion-icon>

                                    <span>Xóa</span>

                                </button>


                            </form>


                        </div>


                    </div>


                </div>


                {{/each}}


            </div>


            <!-- XEM THÊM -->

            <button class="btn load-more">
                Xem thêm bài viết
            </button>


        </div>


        <!-- =========================
             THANH BÊN
        ========================== -->

        <div class="aside">


            <!-- =========================
                 CHỦ ĐỀ
            ========================== -->

            <div class="topics">

                <h2 class="h2">
                    Chủ đề
                </h2>


                <a href="#" class="topic-btn">

                    <div class="icon-box">
                        <ion-icon name="server-outline"></ion-icon>
                    </div>

                    <p>
                        Cơ sở dữ liệu
                    </p>

                </a>


                <a href="#" class="topic-btn">

                    <div class="icon-box">
                        <ion-icon name="accessibility-outline"></ion-icon>
                    </div>

                    <p>
                        Khả năng tiếp cận
                    </p>

                </a>


                <a href="#" class="topic-btn">

                    <div class="icon-box">
                        <ion-icon name="rocket-outline"></ion-icon>
                    </div>

                    <p>
                        Hiệu suất Web
                    </p>

                </a>


            </div>


            <!-- =========================
                 THẺ
            ========================== -->

            <div class="tags">

                <h2 class="h2">
                    Thẻ
                </h2>


                <div class="wrapper">

                    <button class="hashtag">
                        #mongodb
                    </button>

                    <button class="hashtag">
                        #nodejs
                    </button>

                    <button class="hashtag">
                        #accessibility
                    </button>

                    <button class="hashtag">
                        #webperf
                    </button>

                </div>


            </div>


            <!-- =========================
                 LIÊN HỆ
            ========================== -->

            <div class="contact">

                <h2 class="h2">
                    Hãy liên hệ
                </h2>


                <div class="wrapper">

                    <p>
                        Bạn muốn tìm hiểu thêm về cách tôi có thể giúp doanh nghiệp của bạn giải quyết các vấn đề?
                    </p>

                </div>


            </div>


            <!-- =========================
                 ĐĂNG KÝ NHẬN TIN
            ========================== -->

            <div class="newsletter">

                <h2 class="h2">
                    Bản tin
                </h2>


                <div class="wrapper">

                    <p>
                        Đăng ký nhận những bài viết mới nhất từ chúng tôi.
                    </p>


                    <form action="#">

                        <input
                            type="email"
                            name="email"
                            placeholder="Địa chỉ email"
                            required>


                        <button
                            type="submit"
                            class="btn btn-primary">

                            Đăng ký

                        </button>


                    </form>


                </div>


            </div>


        </div>


    </div>


</div>
