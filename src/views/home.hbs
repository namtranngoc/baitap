<div class="hero">

    <div class="container">

        <div class="left">

            <h1 class="h1">
                Xin chào, tôi là
                <b>Hung&nbsp;Nguyen</b>.
                <br>
                Lập trình viên Web
            </h1>

            <p class="h3">
                Chuyên về phát triển website và hiệu suất Web
            </p>

            <div>
                <a href="/contact" class="btn btn-primary">
                    Liên hệ với tôi
                </a>

                <a href="/about" class="btn btn-secondary">
                    Giới thiệu
                </a>
            </div>

        </div>

        <div class="right">

            <div class="pattern-bg"></div>

            <div class="img-box">
                <img src="/img/hero.png" alt="Ảnh đại diện" class="hero-img">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
            </div>

        </div>

    </div>

</div>

<div class="main">

    <div class="container">

        <!-- =========================
             DANH SÁCH BÀI VIẾT
        ========================== -->
        <div class="blog">

            <h2 class="h2">
                Bài viết mới nhất
            </h2>

            <div class="blog-card-group">

                {{#each blogs}}

                <div class="blog-card">

                    <!-- ẢNH -->
                    <div class="blog-card-banner">
                        <img src="{{this.image}}" alt="{{this.name}}" width="250" class="blog-banner-img">
                    </div>

                    <!-- NỘI DUNG -->
                    <div class="blog-content-wrapper">

                        <button class="blog-topic text-tiny">
                            Bài viết
                        </button>

                        <!-- TIÊU ĐỀ -->
                        <h3>
                            <a href="/blogs/{{this.slug}}" class="h3">
                                {{this.name}}
                            </a>
                        </h3>

                        <!-- MÔ TẢ -->
                        <p class="blog-text">
                            {{this.description}}
                        </p>

                        <!-- THÔNG TIN -->
                        <div class="wrapper-flex">
                            <div class="wrapper">
                                <a href="#" class="h4">
                                    Quản trị viên
                                </a>

                                <!-- NGÀY ĐĂNG -->
                                <p class="text-sm">
                                    <time>
                                        {{this.createdAtVN}}
                                    </time>
                                </p>
                            </div>
                        </div>

                        <!-- =========================
                             SỬA / XÓA
                        ========================== -->
                        <div class="blog-card-actions">

                            <!-- SỬA -->
                            <a href="/blogs/{{this._id}}/edit" class="blog-action-btn edit">
                                <ion-icon name="create-outline"></ion-icon>
                                <span>Sửa</span>
                            </a>

                            <!-- XÓA -->
                            <form method="POST" action="/blogs/{{this._id}}?_method=DELETE" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                <button type="submit" class="blog-action-btn delete">
                                    <ion-icon name="trash-outline"></ion-icon>
                                    <span>Xóa</span>
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

                {{/each}}

            </div>

            <!-- =========================
                 PHÂN TRANG (1 HÀNG GỌN GÀNG)
            ========================== -->
            {{#if totalPages}}
                <div class="compact-pagination-wrapper">
                    <div class="compact-pagination">

                        <!-- NÚT TRƯỚC -->
                        {{#if hasPrevious}}
                            <a href="/?page={{previousPage}}" class="compact-page-btn">
                                <ion-icon name="chevron-back-outline"></ion-icon>
                                <span>Trước</span>
                            </a>
                        {{else}}
                            <span class="compact-page-btn disabled">
                                <ion-icon name="chevron-back-outline"></ion-icon>
                                <span>Trước</span>
                            </span>
                        {{/if}}

                        <!-- HIỂN THỊ DẠNG: 2 / 17 (LIỀN MẠCH TRÊN 1 DÒNG) -->
                        <div class="compact-page-status">
                            <span class="current-page">{{currentPage}}</span> / <span class="total-pages">{{totalPages}}</span>
                        </div>

                        <!-- NÚT SAU -->
                        {{#if hasNext}}
                            <a href="/?page={{nextPage}}" class="compact-page-btn">
                                <span>Sau</span>
                                <ion-icon name="chevron-forward-outline"></ion-icon>
                            </a>
                        {{else}}
                            <span class="compact-page-btn disabled">
                                <span>Sau</span>
                                <ion-icon name="chevron-forward-outline"></ion-icon>
                            </span>
                        {{/if}}

                    </div>
                </div>
            {{/if}}
    </div>

</div>
