```hbs
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Liên hệ với chúng tôi
                    </h2>


                    {{#if success}}

                        <div class="alert alert-success">
                            {{success}}
                        </div>

                    {{/if}}


                    <form action="/contact" method="POST">


                        <!-- HỌ VÀ TÊN -->

                        <div class="mb-3">

                            <label
                                for="name"
                                class="form-label">

                                Họ và tên

                            </label>


                            <input
                                type="text"
                                class="form-control"
                                id="name"
                                name="name"
                                placeholder="Nhập họ và tên của bạn"
                                required
                            >

                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label
                                for="email"
                                class="form-label">

                                Địa chỉ email

                            </label>


                            <input
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                                placeholder="Nhập địa chỉ email của bạn"
                                required
                            >

                        </div>


                        <!-- NỘI DUNG -->

                        <div class="mb-3">

                            <label
                                for="message"
                                class="form-label">

                                Nội dung tin nhắn

                            </label>


                            <textarea
                                class="form-control"
                                id="message"
                                name="message"
                                rows="5"
                                placeholder="Nhập nội dung tin nhắn của bạn..."
                                required
                            ></textarea>

                        </div>


                        <!-- NÚT GỬI -->

                        <button
                            type="submit"
                            class="btn btn-primary w-100">

                            Gửi tin nhắn

                        </button>


                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
```
