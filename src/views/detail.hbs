<div class="mt-5">

    {{#if blog}}

    <div class="row">
        <div class="col-lg-9">

            <h1 class="h2">{{blog.name}}</h1>

            <p class="text-muted text-sm mt-2">
                Ngày đăng: {{blog.createdAt}}
            </p>

            <hr>

            <div class="blog-detail-content mt-4">

                <img src="{{blog.image}}" 
                     alt="{{blog.name}}" 
                     class="img-fluid rounded mb-4">

                <p>
                    {{{blog.description}}}
                </p>

            </div>

        </div>

        <div class="col-lg-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tác giả</h5>
                    <p class="card-text">Admin</p>

                    <a href="/contact" class="btn btn-outline-primary btn-sm">
                        Liên hệ
                    </a>
                </div>
            </div>
        </div>

    </div>

    {{else}}

        <h2>Không tìm thấy bài viết</h2>

    {{/if}}

</div>